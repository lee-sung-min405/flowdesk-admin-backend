# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD= root1234
DB_DATABASE=flowdesk_admin_dev
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Connection Pool
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000

# Migration
DB_MIGRATIONS_RUN=true
DB_MIGRATIONS_TABLE=typeorm_migrations

# Timezone
TZ=Asia/Seoul
DB_TIMEZONE=+09:00